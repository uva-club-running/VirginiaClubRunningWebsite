---
import Layout from "../layouts/Layout.astro";
export const prerender = false;
import { listDocuments } from "../lib/firestore.js";
import NavBar from "./_components/NavBar.astro";
import { calendarDay, formatDate, safeLink } from "../lib/content.js";
const today = calendarDay(new Date());
const events = (await listDocuments("Philanthropy"))
  .filter((e) => e.name && calendarDay(e.date) >= today)
  .sort((a, b) => new Date(a.date) - new Date(b.date));
---

<Layout title="Philanthropy | Club Running at UVA">
  <div class="min-h-screen bg-uva-orange-25-percent">
    <NavBar />

    {/* Splash Section */}
    <div
      class="relative w-screen"
      style={{
        height: "70vh",
        backgroundImage: "url(/assets/landing_splash.png)",
        backgroundSize: "cover",
        backgroundPosition: "center",
        backgroundAttachment: "fixed",
        backgroundRepeat: "no-repeat",
      }}
    >
      <div class="absolute inset-0 flex items-center justify-center flex-col">
        <h1 class="text-white text-5xl md:text-7xl lg:text-9xl font-bold font-franklin">
          Philanthropy
        </h1>
        <h2 class="mt-3 text-center text-secondary-orange text-3xl md:text-5xl lg:text-7xl font-bodoni italic">
          Run for a cause.
        </h2>
      </div>
    </div>

    {/* Upcoming Events Section */}
    <div class="max-w-6xl mt-10 mx-auto px-8 pb-10">
      <h2 class="text-4xl font-franklin text-secondary-orange mb-10 text-center">
        Upcoming Community Events
      </h2>
      {events.length === 0 ? (
        <p class="text-center text-xl text-gray-600 italic">
          No upcoming events — check back soon!
        </p>
      ) : (
        <div class="grid md:grid-cols-2 gap-12">
          {events.map((event) => {
            const dateText = formatDate(event.date, true);
            return (
              <div class="bg-white rounded-2xl shadow-md overflow-hidden p-6 space-y-4 transition-transform transform hover:scale-[1.02]">
                <h3 class="text-3xl font-franklin text-secondary-orange">
                  {event.name}
                </h3>
                <p class="text-gray-700 font-medium">{dateText}</p>

                {event.description && (
                  <p class="text-gray-800">{event.description}</p>
                )}

                {event.partner_org && (
                  <p class="text-gray-600 italic">
                    Partner Organization: {event.partner_org}
                  </p>
                )}

                <div class="space-x-6">
                  {safeLink(event.link) && (
                    <a
                      href={safeLink(event.link)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-block text-secondary-orange underline font-semibold"
                    >
                      Learn More →
                    </a>
                  )}
                  {safeLink(event.flyer_link) && (
                    <a
                      href={safeLink(event.flyer_link)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-block text-secondary-orange underline font-semibold"
                    >
                      View Flyer →
                    </a>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>

    {/* Overview Section */}
    <div class="max-w-5xl mx-auto px-8 py-20 text-gray-800 space-y-6">
      <h2 class="text-4xl font-franklin text-secondary-orange mb-10 text-center">
        Philanthropy Overview
      </h2>
      <p class="text-lg leading-relaxed">
        Each year, Club Running hosts philanthropy events that raise money for
        charities such as <span class="font-semibold">Girls on the Run</span>,{" "}
        <span class="font-semibold">Special Olympics</span>, and{" "}
        <span class="font-semibold">UVA Children's Hospital</span>. Club members
        can get involved by registering to compete in the events or volunteering
        to help organize. The efforts of our volunteers play a crucial role in
        making each one such a tremendous success.
      </p>

      <p class="text-lg leading-relaxed">
        <span class="font-semibold">October 2024's Philanthropy 5K</span> raised
        over <span class="font-semibold">$500</span> for{" "}
        <span class="font-semibold">Prolyfyck Run Crew</span>. Prizes included
        gift cards to local restaurants and{" "}
        <span class="font-semibold">Ragged Mountain Running Store</span>{" "}
        merchandise.
      </p>

      <p class="text-lg leading-relaxed">
        <span class="font-semibold">
          April 2024's Run-a-Thon and Relay Fest
        </span>{" "}
        raised over <span class="font-semibold">$650</span> for Club Running.
        Prizes included gift cards to local restaurants and Ragged Mountain
        Running Store merchandise. Further, the{" "}
        <span class="font-semibold">
          Philanthropy Committee's Bake Sale and Lemonade Stand
        </span>{" "}
        raised an additional <span class="font-semibold">$250</span> for the
        Club.
      </p>
    </div>

    {/* Committee Section */}
    <div class="bg-white py-20">
      <div class="max-w-5xl mx-auto px-8 text-center text-gray-800">
        <h2 class="text-4xl font-franklin text-secondary-orange mb-8">
          Philanthropy Committee
        </h2>
        <p class="text-lg leading-relaxed mb-6">
          Club members who are interested in taking on a more involved role in
          the club's philanthropy efforts can join our philanthropy committee.
          Committee members help plan and organize philanthropic events
          alongside our executive board.
        </p>
        <p class="text-lg leading-relaxed">
          If you are interested in joining the philanthropy committee, contact
          our <span class="font-semibold">philanthropy chair</span>.
        </p>
      </div>
    </div>
  </div>
</Layout>
