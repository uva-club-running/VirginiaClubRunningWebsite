---
import Layout from "../layouts/Layout.astro";
import NavBar from "./_components/NavBar.astro";
---

<Layout title="Community | Club Running at UVA">
  <div class="min-h-screen bg-uva-orange-25-percent text-tertiary-darkblue">
    <NavBar />

    {/* Social Splash */}
    <div
      class="relative w-screen"
      style={{
        height: "50vh",
        backgroundImage: "url('/assets/landing_splash.png')",
        backgroundSize: "cover",
        backgroundPosition: "center",
        backgroundAttachment: "fixed",
        backgroundRepeat: "no-repeat",
      }}
    >
      <div class="absolute inset-0 flex flex-col items-center justify-center bg-black/40 text-center">
        <h1 class="text-white text-6xl md:text-8xl font-bold font-franklin">
          Social
        </h1>
        <h2 class="mt-4 text-secondary-orange text-3xl md:text-5xl italic font-bodoni">
          Frolic. Bond. Repeat.
        </h2>
      </div>
    </div>

    {/* Social Section */}
    <div class="max-w-6xl mx-auto px-8 py-20 text-lg space-y-8">
      <section>
        <h3 class="text-4xl font-franklin text-secondary-orange mb-4">Social</h3>
        <p>We host parties every 2–3 weeks.</p>
        <p>
          <strong>Frolicsome Fridays</strong> take the place of regular Friday
          practice. Come play other sports (soccer, frisbee, spikeball) with
          fellow Club Runners!
        </p>
        <p>
          We also organize events like apple picking, group fitness classes,
          Sunset Series trips, and intramural teams for sports like soccer and
          volleyball.
        </p>
      </section>
    </div>

    {/* Alumni / Parents Splash */}
    <div
      class="relative w-screen"
      style={{
        height: "50vh",
        backgroundImage:
          "url('/assets/old_website_files/images/splash/donate/pyramid.jpg')",
        backgroundSize: "cover",
        backgroundPosition: "center",
        backgroundAttachment: "fixed",
        backgroundRepeat: "no-repeat",
      }}
    >
      <div class="absolute inset-0 flex flex-col items-center justify-center bg-black/40 text-center">
        <h1 class="text-white text-6xl md:text-8xl font-bold font-franklin">
          Alumni & Parents
        </h1>
        <h2 class="mt-4 text-secondary-orange text-3xl md:text-5xl italic font-bodoni">
          For the olds.
        </h2>
      </div>
    </div>

    {/* Alumni Content */}
    <div class="max-w-6xl mx-auto px-8 py-20 text-lg space-y-8">
      <section>
        <h3 class="text-4xl font-franklin text-secondary-orange mb-4">
          Connect with Club Running
        </h3>
        <p>
          Recently graduated and already missing your Club Running pals? Parent
          of a Club Runner who wants to stay in the loop? Join our{" "}
          <a href="/contact#treasurer" class="text-secondary-orange underline">
            Alumni Listserv
          </a>{" "}
          to get semesterly recaps, racing opportunities, and other updates —
          just 3–4 emails per semester.
        </p>
        <p>
          Check out our{" "}
          <a
            href="https://www.instagram.com/hoosrunning/"
            class="text-secondary-orange underline"
          >
            Instagram
          </a>{" "}
          and{" "}
          <a
            href="https://www.youtube.com/@hoosrunning"
            class="text-secondary-orange underline"
          >
            YouTube
          </a>{" "}
          to see what members are up to!
        </p>
      </section>

      <section>
        <h3 class="text-4xl font-franklin text-secondary-orange mb-4">
          Donate to Club Running
        </h3>
        <p>
          Donations help fund our meets, subsidize member dues, and support
          community events. We’re deeply grateful for your support!
        </p>
        <ul class="list-disc pl-6 space-y-2">
          <li>Subsidize members’ social/racing dues</li>
          <li>Organize meets at Lannigan Field and Panorama Farms</li>
          <li>Host fundraising events benefiting the community</li>
        </ul>
        <p>
          Contribute via{" "}
          <a
            href="https://account.venmo.com/u/running-club-uva"
            class="text-secondary-orange underline"
          >
            Venmo
          </a>{" "}
          or contact our{" "}
          <a href="/contact#treasurer" class="text-secondary-orange underline">
            Treasurer
          </a>{" "}
          for other methods.
        </p>
      </section>
    </div>

    {/* Charlottesville Splash Section */}
    <div
      class="relative w-screen"
      style={{
        height: "50vh",
        backgroundImage:
          "url('/assets/old_website_files/images/splash/charlottesville/1.png')",
        backgroundSize: "cover",
        backgroundPosition: "center",
        backgroundAttachment: "fixed",
        backgroundRepeat: "no-repeat",
      }}
    >
      <div class="absolute inset-0 flex flex-col items-center justify-center bg-black/40 text-center">
        <h1 class="text-white text-6xl md:text-8xl font-bold font-franklin">
          Running in Charlottesville
        </h1>
        <h2 class="mt-4 text-secondary-orange text-3xl md:text-5xl italic font-bodoni">
          A beautiful place to exercise & explore.
        </h2>
      </div>
    </div>

    {/* Charlottesville Routes */}
    <div class="max-w-6xl mx-auto px-8 py-20 space-y-24">
      {/* Short */}
      <section>
        <h3 class="text-4xl font-franklin text-secondary-orange mb-8">
          Short (0–5 Miles)
        </h3>
        <div class="grid md:grid-cols-2 gap-10">
          {[
            ["Guys’ Downtown", "2497676"],
            ["Park Trails", "2497677"],
            ["Stribling", "2497680"],
            ["Becca’s Loop", "2497681"],
            ["Girls’ Downtown", "2497682"],
            ["Azalea", "2497686"],
            ["Good Night, Mr. Jefferson...", "2497688"],
          ].map(([name, id]) => (
            <div>
              <h4 class="text-2xl font-bold mb-2">{name}</h4>
              <div class="aspect-video relative overflow-hidden rounded-lg shadow-md">
                <iframe
                  src={`https://www.plotaroute.com/embedmap/${id}?units=miles`}
                  class="absolute top-0 left-0 w-full h-full"
                  frameborder="0"
                  scrolling="no"
                  allowfullscreen
                  title={name}
                ></iframe>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* Medium */}
      <section>
        <h3 class="text-4xl font-franklin text-secondary-orange mb-8">
          Medium (5–8 Miles)
        </h3>
        <div class="grid md:grid-cols-2 gap-10">
          {[
            ["Post-It", "2497692"],
            ["Foxhaven", "2497694"],
            ["CHS", "2497695"],
            ["Cow Pasture", "2497710"],
          ].map(([name, id]) => (
            <div>
              <h4 class="text-2xl font-bold mb-2">{name}</h4>
              <div class="aspect-video relative overflow-hidden rounded-lg shadow-md">
                <iframe
                  src={`https://www.plotaroute.com/embedmap/${id}?units=miles`}
                  class="absolute top-0 left-0 w-full h-full"
                  frameborder="0"
                  scrolling="no"
                  allowfullscreen
                  title={name}
                ></iframe>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* Long */}
      <section>
        <h3 class="text-4xl font-franklin text-secondary-orange mb-8">
          Long (8+ Miles)
        </h3>
        <div class="grid md:grid-cols-2 gap-10">
          {[
            ["Ridge Road 🚗", "2497711"],
            ["Reservoir", "2497712"],
            ["Rivanna Trail +", "2497714"],
            ["Dick Woods 🚗", "2497719"],
          ].map(([name, id]) => (
            <div>
              <h4 class="text-2xl font-bold mb-2">{name}</h4>
              <div class="aspect-video relative overflow-hidden rounded-lg shadow-md">
                <iframe
                  src={`https://www.plotaroute.com/embedmap/${id}?units=miles`}
                  class="absolute top-0 left-0 w-full h-full"
                  frameborder="0"
                  scrolling="no"
                  allowfullscreen
                  title={name}
                ></iframe>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* Credit */}
      <p class="text-center text-gray-600">
        All maps generated using{" "}
        <a
          href="https://www.plotaroute.com/routeplanner"
          class="text-secondary-orange underline"
        >
          Plot a Route
        </a>
        .
      </p>
    </div>
  </div>
</Layout>
