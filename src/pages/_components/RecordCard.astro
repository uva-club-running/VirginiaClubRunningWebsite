---
const { record, color } = Astro.props;
const isMen = color === "men";
---

<div class="group bg-white/60 backdrop-blur-sm rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105 border border-white/20">
  <div class="space-y-2">
    <h4
      class={`text-xl font-bold font-franklin text-gray-900 transition-colors duration-200 ${
        isMen ? "group-hover:text-primary-blue" : "group-hover:text-secondary-orange"
      }`}
    >
      {record.event}
    </h4>
    <p class="text-lg font-franklin italic text-gray-700 group-hover:text-gray-900 transition-colors duration-200">
      {record.name}
    </p>
    <p
      class={`text-2xl font-bold font-franklin transition-colors duration-200 ${
        isMen
          ? "text-secondary-orange group-hover:text-primary-blue"
          : "text-primary-blue group-hover:text-secondary-orange"
      }`}
    >
      {record.time || ""}
    </p>
    <p class="text-gray-600">{record.year}</p>
  </div>
</div>
